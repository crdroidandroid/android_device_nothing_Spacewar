on early-init
    stop vendor.perfd
    stop vendor.perfd-1-0
    stop vendor.perfd-2-0
    stop vendor.qti.perfd
    setprop vendor.perf.disable 1
    setprop vendor.powerhal.disable.perfd true
    setprop log.tag.QTI.PowerHAL S
    setprop log.tag.PowerHAL S
    setprop log.tag.QTI.Power S
    setprop log.tag.android.hardware.power S
    setprop persist.vendor.log.tag.power S
    setprop persist.vendor.log.tag.qti_power S

on boot
    stop vendor.perfd
    stop vendor.perfd-1-0
    stop vendor.perfd-2-0
    stop vendor.qti.perfd

on property:vendor.camera.running=1
    setprop vendor.powerhal.camera.boost false
