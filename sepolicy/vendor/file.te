# Fingerprint
type fingerprint_data_file, data_file_type, file_type;

# sysfs
type sysfs_torch, sysfs_type, fs_type;

# Camera
allow cameraserver camera_device:chr_file rw_file_perms;
allow cameraserver vendor_camera_prop:file { read open getattr };
allow hal_camera_default vendor_file:file { read open getattr };
